{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " ➜  "
    },
    "modules": [
        {
            "type": "title",
            "key": " User    ",
            "format": "{user-name}",
            "keyColor": "blue"
        },
        {
            "type": "title",
            "key": "󰌢 Host    ",
            "format": "{host-name}",
            "keyColor": "blue"
        },
        {
            "type": "os",
            "key": " OS      ",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel  ",
            "keyColor": "cyan"
        },
        {
            "type": "cpu",
            "key": " CPU     ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU     ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory  ",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk    ",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": " Shell   ",
            "keyColor": "magenta"
        },
        "break",
        "colors"
    ]
}
