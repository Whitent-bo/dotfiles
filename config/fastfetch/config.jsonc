{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 0,
            "right": 2
        }
    },
    "display": {
        "separator": " ➜ ",
        "disableLinewrap": true
    },
    "modules": [
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────┐"
        },
        {
            "type": "title",
            "key": " User    ",
            "format": "{user-name}",
            "keyColor": "blue"
        },
        {
            "type": "title",
            "key": "󰌢 Host    ",
            "format": "{host-name}",
            "keyColor": "blue"
        },
        {
            "type": "os",
            "key": " OS      ",
            "format": "Debian {9} ({10})",
            "keyColor": "cyan"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel  ",
            "format": "{2}",
            "keyColor": "cyan"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime  ",
            "keyColor": "cyan"
        },
        {
            "type": "wm",
            "key": "󱂬 WM      ",
            "keyColor": "cyan"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages",
            "format": "{1} (dpkg)",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": " CPU     ",
            "format": "{name}",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU     ",
            "format": "{2}",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "󰍛 Memory  ",
            "keyColor": "yellow"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk    ",
            "format": "{1} / {2} ({3})",
            "keyColor": "yellow"
        },
        {
            "type": "battery",
            "key": "󰂂 Battery ",
            "format": "{4}% [{5}]",
            "keyColor": "yellow"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "magenta"
        },
        {
            "type": "shell",
            "key": " Shell   ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
